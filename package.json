{
  "name": "twin-db",
  "version": "2.0.0",
  "description": "A usefully local database.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "tsx src/index.ts",
    "prettier": "npx prettier --write \"**/*.{js,ts}\"",
    "build": "npx tsup"
  },
  "author": {
    "name": "Jaelson Kaciel",
    "email": "jaelsonkaciel4@gmail.com",
    "url": "https://github.com/toddy007"
  },
  "keywords": [
    "db",
    "database",
    "local",
    "localdb",
    "localdatabase",
    "twin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toddy007/twin-db.git"
  },
  "engines": {
    "node": ">=21.6.2"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "mongoose": "^9.7.3"
  }
}
